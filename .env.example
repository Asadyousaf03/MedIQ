# Shared Postgres (Supabase connection string — use Transaction pooler or direct)
POSTGRES_CONNECTION_STRING=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Auth (required in production)
AUTH_SECRET=replace-with-a-long-random-string

# Express API
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Google Vertex AI (Mastra agent)
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
# Or: GOOGLE_GENERATIVE_AI_API_KEY=
